---
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const raw_path = Astro.params.path || "";
const language = raw_path === "en" || raw_path.startsWith("en/") ? "en" : undefined;
const slug = language ? raw_path.slice(3) : raw_path;

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get(
  `cdn/stories/${slug || 'home'}`,
  {
    version: 'draft',
    resolve_relations: ['vacancy.partner', 'vcp-page.people'],
    language
  }
);

const story = data.story;
---

<Layout language={language} slug={slug}>
	<StoryblokComponent blok={story.content} uuid={story.uuid} language={language} slug={slug} />
</Layout>
