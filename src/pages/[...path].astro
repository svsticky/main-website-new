---
import type { GetStaticPaths } from "astro";
import { getStories, get } from '../storyblok';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';

export const getStaticPaths = (async () => {
  // undefined is the default language
  const languages = [undefined, "en"];

  const pages_per_language = await Promise.all(languages.map(async language => {
    const response = await getStories({ version: "draft", language, per_page: 100 });
    let stories = response.data.stories, remaining_count = response.total - stories.length, page = 1;
    while (remaining_count > 0) {
      const response = await getStories({ version: "draft", page: ++page, per_page: 100, language });
      remaining_count -= response.data.stories.length;
      stories = stories.concat(response.data.stories);
    }

    return stories.map(s => {
      return s.full_slug === `${language ? `${language}/` : ""}home`
        ? ({ params: { path: `/${language ?? ""}` }, props: { slug: "", language }})
        : ({ params: { path: `/${s.full_slug}` }, props: { slug: s.full_slug.slice(language ? language.length + 1 : 0), language }})
    });
  }));
  return pages_per_language.flat();
}) satisfies GetStaticPaths;

const { slug, language } = Astro.props;

const { data } = await get(
  `cdn/stories/${slug || 'home'}`,
  {
    version: 'draft',
    resolve_relations: ['vacancy.partner', 'vcp-page.people'],
    language
  }
);

function preloaded_url(url: string) {
  const storyblok_url_parts = url.split("/");
  return `https://${Astro.site!.host}/assets/preloaded/${storyblok_url_parts[storyblok_url_parts.length - 1]}`;
}

const story = data.story;
let title, description, article, image = "https://public.svsticky.nl/logos/hoofd_outline_kleur.svg";
switch (story.content.component) {
  case "page":
    title = story.content.title;
    description = story.content.description || "";
    break;
  case "board":
    title = `${language === "en" ? "Board" : "Bestuur"} ${story.content.board_number} - Studievereniging Sticky`;
    description = language === "en"
      ? `Information page about board ${story.content.board_number}.`
      : `Informatiepagina over bestuur ${story.content.board_number}`;
    image = preloaded_url(story.content.photo.filename);
    break;
  case "vacancy":
    title = `${story.content.name} ${language === "en" ? "at" : "bij"} ${story.content.partner[0].content.name} - Studievereniging Sticky`;
    description = story.content.short_text;
    image = preloaded_url(story.content.partner[0].content.logo.filename);
    break;
  case "partner":
    title = `${story.content.name} - Studievereniging Sticky`;
    description = language === "en"
      ? `Information page about Sticky's partner ${story.content.name}.`
      : `Informatiepagina over Sticky's partner ${story.content.name}.`;
    image = preloaded_url(story.content.logo.filename);
    break;
  case "committee":
    title = `${story.content.name} - Studievereniging Sticky`;
    description = language === "en"
      ? story.content.description || `Information page about ${story.content.name}.`
      : story.content.description || `Informatiepagina over ${story.content.name}.`;
    image = preloaded_url(story.content.logo.filename);
    break;
  case "society":
    title = `${story.content.name} - Studievereniging Sticky`;
    description = language === "en"
      ? story.content.short_text || `Information page about ${story.content.name}.`
      : story.content.short_text || `Informatiepagina over ${story.content.name}.`;
    image = preloaded_url(story.content.logo.filename);
    break;
  case "news-item":
    title = story.content.title;
    article = {
      publishedTime: new Date(story.content.date).toISOString(),
      tags: story.content.keywords?.length ? story.content.keywords.split("\n") : []
    };
    image = preloaded_url(story.content.image.filename);
    break;
  case "vcp-page":
    title = language === "en" ? "Social Safety - Study Association Sticky" : "Social veiligheid - Studievereniging Sticky";
    description = language === "en"
      ? "If there is something you want to talk about, you can come to the confidential contact persons with your story. This is how we try to make sure Sticky is and remains a safe environment for everyone."
      : "Als er iets is waar je over wilt praten, kun je bij de vertrouwenscontactpersonen terecht met je verhaal. Zo proberen we ervoor te zorgen dat Sticky voor iedereen een veilige omgeving is en blijft.";
    break;
  case "links-page":
    title = language === "en" ? "External links - Study Association Sticky" : "Externe links - Studievereniging Sticky";
    description = language === "en"
      ? "This page lists all external links to relevant services and document associated with Sticky."
      : "Deze pagina bevat allerlei externe links naar relevante services en documenten geassocieerd met Sticky.";
    break;
  case "news-overview":
    title = language === "en" ? "News - Study Association Sticky" : "Nieuws - Studievereniging Sticky";
    description = language === "en"
      ? "The latest news about important events in the association can be found here."
      : "De laatste nieuwtjes over belangrijke dingen in de vereniging kan je hier vinden.";
    break;
}
---

<Layout language={language} slug={slug} title={title} description={description} article={article} image={image}>
	<StoryblokComponent blok={story.content} uuid={story.uuid} language={language} slug={slug} />
</Layout>
