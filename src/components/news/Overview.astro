---
import { renderRichText, storyblokEditable } from '@storyblok/astro';
import { Image } from 'astro:assets';
import { getAll } from '../../storyblok';
const { blok, language } = Astro.props;

const news_items = await getAll('cdn/stories', {
  version: 'published',
  starts_with: 'nieuws',
  content_type: 'news-item',
  sort_by: 'content.date:desc',
  language
});

const date_formatter = new Intl.DateTimeFormat(
  language === undefined ? 'nl-NL' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' }
);
function format_date(date: string) {
  if (!date) return '';
  return date_formatter.format(new Date(date.replace(' ', 'T')));
}

function get_excerpt(richtext: any, max_length = 180) {
  const text = renderRichText(richtext || {}).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  if (text.length <= max_length) return text;
  return text.slice(0, max_length).replace(/\s+\S*$/, '') + '...';
}
---

<ul class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-start" {...storyblokEditable(blok)}>
  {news_items.map((item: any) => (
    <li class="h-full">
      <a href={`${language === undefined ? "" : `/${language}`}/nieuws/${item.slug}`} class="group flex flex-col h-full border border-neutral-200 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow transition">
        {item.content.image?.filename &&
          <Image src={item.content.image.filename} width={500} height={200} alt={item.content.image.title} class="w-full h-44 object-cover" />}
        <div class="p-4 flex flex-col gap-1">
          <span class="text-xs text-neutral-500">{format_date(item.content.date)}</span>
          <h3 class="font-bold text-lg group-hover:text-[var(--brand)] transition">{item.content.title}</h3>
          <p class="text-sm text-neutral-600 mt-1">{get_excerpt(item.content.content)}</p>
          <span class="text-sm font-semibold text-[var(--brand)] mt-2">
            {language === undefined ? "Lees verder" : "Learn more"}
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>
