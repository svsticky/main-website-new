---
import { storyblokEditable } from '@storyblok/astro';
import RichText from '../basics/RichText.astro';
const { blok, language } = Astro.props;
---

<div class="border border-neutral-300 rounded-xl p-8 flex flex-col gap-4" {...storyblokEditable(blok)}>
  <RichText content={blok.header} />
  <form action="/api/mail" method="post" class="flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <label class="text-sm" for="company">
        {language === undefined ? "Bedrijfsnaam " : "Company name "}
        <span class="text-red-500">*</span>
      </label>
      <input class="border border-neutral-300 rounded-xl px-2 py-1" type="text" required name="company" id="company">
    </div>

    <div class="flex flex-col gap-1">
      <label class="text-sm" for="name">
        {language === undefined ? "Naam contactpersoon " : "Name contact person "}
        <span class="text-red-500">*</span>
      </label>
      <input class="border border-neutral-300 rounded-xl px-2 py-1" type="text" required name="name" id="name">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex flex-col gap-1">
        <label class="text-sm" for="email">
          {language === undefined ? "Emailadres " : "Email address "}
          <span class="text-red-500">*</span>
        </label>
        <input class="border border-neutral-300 rounded-xl px-2 py-1" type="email" required name="email" id="email">
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-sm" for="tel">
          {language === undefined ? "Telefoonnummer" : "Phone number"}
        </label>
        <input class="border border-neutral-300 rounded-xl px-2 py-1" type="tel" name="tel" id="tel">
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label class="text-sm" for="message">
        {language === undefined ? "Bericht / vraag " : "Message / question "}
        <span class="text-red-500">*</span>
      </label>
      <textarea class="border border-neutral-300 rounded-xl px-2 py-1" required name="message" id="message"></textarea>
    </div>

    <button type="submit" class="flex disabled:cursor-not-allowed cursor-pointer w-full bg-[var(--brand)] text-white text-center text-lg px-4 py-2 font-bold rounded-xl hover:bg-[var(--brand-dark)] group transition">
      <div class="mx-auto">
        {language === undefined ? "Versturen" : "Submit"}
        <i class="ml-2 fas fa-paper-plane my-auto group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition"></i>
      </div>
    </button>
  </form>
</div>

<script>
  import { actions } from "astro:actions";
import { experimental_getFontFileURL } from "astro:assets";

  const form = document.querySelector("form")!;
  const submit_button = form.querySelector("button[type='submit']")! as HTMLButtonElement;
  form.addEventListener("submit", async event => {
    event.preventDefault();
    const form_data = new FormData(form);

    // TODO: Loading spinner
    const spinner = document.createElement("i");
    spinner.classList.add("fas", "fa-spinner", "fa-spin-pulse", "mx-auto", "text-xl", "my-1");
    submit_button.replaceChildren(spinner);
    submit_button.disabled = true;

    const { error } = await actions.mail(form_data);

    const container = document.createElement("div");
    container.classList.add("mx-auto");

    if (error) {
      const text = document.createTextNode(
        document.documentElement.lang === "nl" ? "Niet gelukt" : "Could not send!"
      );
      container.appendChild(text);

      const check = document.createElement("i");
      check.classList.add("fas", "fa-exclamation", "fa-shake", "ml-2", "my-auto");
      check.style.setProperty("--fa-animation-iteration-count", "1");
      check.style.setProperty("--fa-animation-duration", "3s");
      container.appendChild(check);

      const explanation = document.createElement("p");
      explanation.appendChild(document.createTextNode(
        document.documentElement.lang === "nl"
          ? "Het versturen van uw antwoord is niet gelukt. Herlaad de pagina en probeer het opnieuw, of stuur een mail naar "
          : "Sending your answers failed. Reload the page and try again, or send a mail to "
      ));
      const mail_link = document.createElement("a");
      mail_link.href = "mailto:extern@svsticky.nl";
      mail_link.innerText = "extern@svsticky.nl";
      mail_link.classList.add("text-blue-500", "hover:underline");
      explanation.appendChild(mail_link);
      explanation.appendChild(document.createTextNode("."));
      form.appendChild(explanation);
    } else {
      const text = document.createTextNode(
        document.documentElement.lang === "nl" ? "Verstuurd!" : "Sent!"
      );
      container.appendChild(text);

      const check = document.createElement("i");
      check.classList.add("fas", "fa-check", "fa-beat", "ml-2", "my-auto");
      check.style.setProperty("--fa-animation-iteration-count", "1");
      container.appendChild(check);
    }

    submit_button.replaceChildren(container);
  });
</script>