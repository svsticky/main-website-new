---
import { storyblokEditable } from '@storyblok/astro';
import { Image } from 'astro:assets';
import RichText from '../basics/RichText.astro';
import { getAll } from '../../storyblok';
const { blok, language } = Astro.props;

const vacancies = await getAll('cdn/stories', {
  version: 'published',
  starts_with: 'carriere/vacatures',
  content_type: 'vacancy',
  resolve_relations: 'vacancy.partner',
});
const featured_vacancies = vacancies.filter((v: any) => v.content.is_featured);
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8" {...storyblokEditable(blok)}>
  <div class="flex flex-col gap-4">
    <h2 class="text-2xl font-bold text-center">
      {language === undefined ? "Wekelijkse borrel" : "Weekly drinks"}
    </h2>
    <div id="drinks-card" class="bg-white border border-neutral-200 rounded-2xl p-6 overflow-y-auto">
      <p>
        {language === undefined ? "Elke week is er een borrel om " : "Every week there are drinks at "}
        <strong>{blok.drinks_time}</strong> in <strong>{blok.drinks_location}</strong>
        {language === undefined
          ? " waar je even kunt socialisen met je mede-leden. "
          : " where you can come and socialise with your fellow members. "}
        {language === undefined
          ? "De borrels zijn iedere "
          : "The drinks are every "}
        <strong>{blok.drinks_day}</strong>!
      </p>
      {!!blok.drinks_description?.content?.length && <RichText class="mt-4" content={blok.drinks_description} />}
    </div>
  </div>

  <div class="flex flex-col gap-4">
    <h2 class="text-2xl font-bold text-center">
      {language === undefined
        ? `Uitgelichte vacature${featured_vacancies.length > 1 ? "s" : ""}`
        : `Featured ${featured_vacancies.length > 1 ? "vacancy" : "vacancies"}`}
    </h2>
    {featured_vacancies.length ? (
      <div class="flex flex-col gap-4 flex-1">
        {featured_vacancies.map((vacancy: any) => (
          <a href={`/carriere/vacatures/${vacancy.slug}`} class="vacancy-card group bg-white border border-neutral-200 rounded-2xl p-6 flex-1 flex gap-4 hover:-translate-y-1 hover:shadow transition">
            {vacancy.content.partner?.[0]?.content?.logo?.filename &&
              <Image src={vacancy.content.partner[0].content.logo.filename} width={100} height={100} alt={vacancy.content.partner[0].content.name} class="w-24 h-24 shrink-0 object-contain" />
            }
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-lg group-hover:text-[var(--brand)] transition">{vacancy.content.name}</h3>
              <p class="text-neutral-700">{vacancy.content.short_text}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="vacancy-card bg-white border border-neutral-200 rounded-2xl p-6 flex-1 text-neutral-500 grid">
        <span class="m-auto block">
          {language === undefined
            ? "Er is op dit moment geen vacature uitgelicht."
            : "There is currently no featured vacancy."}
        </span>
      </div>
    )}
  </div>
</div>

<script>
  function match_drinks_card_height() {
    const drinks_card = document.getElementById('drinks-card');
    const first_vacancy_card = document.querySelector<HTMLElement>('.vacancy-card');
    if (!drinks_card || !first_vacancy_card) return;

    drinks_card.style.height = 'auto';
    if (window.matchMedia('(min-width: 768px)').matches) {
      drinks_card.style.height = `${first_vacancy_card.getBoundingClientRect().height}px`;
    }
  }

  match_drinks_card_height();
  window.addEventListener('resize', match_drinks_card_height);
</script>
